// Base de datos de Nexo (PostgreSQL).
// La URL real se resuelve en scripts/db-env.mjs, que acepta los nombres de
// variables de Neon, Vercel Postgres y Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Cuentas y negocios ────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sales        Sale[]
}

/// Un negocio (tenant). Todos los datos cuelgan de aquí.
model Organization {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  /// Clave del sector en src/sectors (general, zapatillas, moda, restauracion, motor…)
  sector         String  @default("general")
  plan           String  @default("free")
  currency       String  @default("EUR")
  /// IVA por defecto en puntos básicos de porcentaje (2100 = 21 %)
  taxRateBp      Int     @default(2100)
  taxId          String?
  address        String?
  phone          String?
  email          String?
  invoicePrefix  String  @default("F")
  /// Objetivo de ventas diario (céntimos, IVA incl.). null = se calcula solo
  dailyGoalCents Int?
  storeEnabled   Boolean @default(true)

  // Suscripción (Stripe). `plan` es la fuente de verdad que usa la app;
  // el webhook de Stripe la mantiene sincronizada.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// active | trialing | past_due | canceled | incomplete…
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())

  memberships      Membership[]
  categories       Category[]
  products         Product[]
  customers        Customer[]
  sales            Sale[]
  stockMovements   StockMovement[]
  cashMovements    CashMovement[]
  competitors      Competitor[]
  competitorPrices CompetitorPrice[]
  suppliers        Supplier[]
  supplyItems      SupplyItem[]
  supplierPrices   SupplierPrice[]
  aiSearches       AiSearch[]
}

model Membership {
  id     String       @id @default(cuid())
  role   String       @default("owner") // owner | admin | staff
  userId String
  orgId  String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

// ─── Catálogo ──────────────────────────────────────────────────────────

model Category {
  id       String       @id @default(cuid())
  orgId    String
  name     String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([orgId, name])
}

model Product {
  id          String   @id @default(cuid())
  orgId       String
  categoryId  String?
  name        String
  sku         String?
  description String?
  imageUrl    String?
  priceCents  Int      @default(0)
  costCents   Int      @default(0)
  /// IVA específico del producto; null = el del negocio
  taxRateBp   Int?
  stock       Int      @default(0)
  trackStock  Boolean  @default(true)
  lowStockAt  Int      @default(2)
  /// Campos propios del sector (talla, colorway, alérgenos, km…)
  attributes  Json
  published   Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems        SaleItem[]
  stockMovements   StockMovement[]
  competitorPrices CompetitorPrice[]
  supplyItems      SupplyItem[]

  @@index([orgId, active])
}

// ─── Clientes ──────────────────────────────────────────────────────────

model Customer {
  id         String   @id @default(cuid())
  orgId      String
  name       String
  email      String?
  phone      String?
  taxId      String?
  address    String?
  notes      String?
  attributes Json
  createdAt  DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sales Sale[]

  @@index([orgId])
}

// ─── Ventas, stock y caja ──────────────────────────────────────────────

model Sale {
  id            String   @id @default(cuid())
  orgId         String
  /// Número correlativo por negocio (sirve de número de factura)
  number        Int
  customerId    String?
  createdById   String?
  status        String   @default("paid") // paid | pending | cancelled
  paymentMethod String   @default("card") // cash | card | transfer | bizum | other
  subtotalCents Int
  taxCents      Int
  totalCents    Int
  notes         String?
  createdAt     DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer  Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     SaleItem[]

  @@unique([orgId, number])
  @@index([orgId, createdAt])
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  productId      String?
  /// Copia del nombre en el momento de la venta (la factura no cambia si se edita el producto)
  name           String
  quantity       Int
  unitPriceCents Int
  taxRateBp      Int
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model StockMovement {
  id        String       @id @default(cuid())
  orgId     String
  productId String
  delta     Int
  reason    String // sale | cancel | adjust | purchase
  saleId    String?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orgId, productId])
}

model CashMovement {
  id          String       @id @default(cuid())
  orgId       String
  /// Positivo = entrada, negativo = salida
  amountCents Int
  method      String       @default("cash")
  concept     String
  saleId      String?
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// ─── Competencia ───────────────────────────────────────────────────────

model Competitor {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  /// fisica | online | marketplace
  kind      String   @default("fisica")
  url       String?
  location  String?
  createdAt DateTime @default(now())

  org    Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  prices CompetitorPrice[]

  @@unique([orgId, name])
}

/// Precio visto en la competencia para uno de mis productos. Se guarda el histórico.
model CompetitorPrice {
  id           String   @id @default(cuid())
  orgId        String
  competitorId String
  productId    String
  priceCents   Int
  url          String?
  note         String?
  observedAt   DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  competitor Competitor   @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orgId, productId])
}

// ─── Proveedores ───────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  contactName String?
  phone       String?
  email       String?
  website     String?
  notes       String?
  createdAt   DateTime @default(now())

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  prices     SupplierPrice[]
  currentFor SupplyItem[]

  @@unique([orgId, name])
}

/// Algo que el negocio compra para producir o revender (harina, tela, zapatillas…)
model SupplyItem {
  id                String   @id @default(cuid())
  orgId             String
  name              String
  /// unidad | kg | litro | caja | metro | docena | par
  unit              String   @default("unidad")
  /// Si es un producto que se revende tal cual, su coste se actualiza con el proveedor elegido
  productId         String?
  currentSupplierId String?
  createdAt         DateTime @default(now())

  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  currentSupplier Supplier?       @relation(fields: [currentSupplierId], references: [id], onDelete: SetNull)
  prices          SupplierPrice[]

  @@unique([orgId, name])
}

/// Precio de un proveedor para una cosa que compro (sin IVA, por unidad). Se guarda el histórico.
model SupplierPrice {
  id           String   @id @default(cuid())
  orgId        String
  supplierId   String
  supplyItemId String
  priceCents   Int
  minOrder     String?
  deliveryDays Int?
  observedAt   DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier   Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplyItem SupplyItem   @relation(fields: [supplyItemId], references: [id], onDelete: Cascade)

  @@index([orgId, supplyItemId])
}

/// Registro de búsquedas automáticas en internet (control de coste y "última vez buscado")
model AiSearch {
  id        String   @id @default(cuid())
  orgId     String
  /// market | supplier | detect
  kind      String
  targetId  String?
  ok        Boolean
  /// Búsqueda de la matriz (revisión mensual / automática): no gasta el cupo del cliente
  central   Boolean  @default(false)
  /// Resultado sacado de la caché compartida: no ha costado nada
  cached    Boolean  @default(false)
  results   Int      @default(0)
  error     String?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, kind, targetId])
}

/// Caché compartida entre todos los negocios: la misma búsqueda se hace una vez
/// y sirve para todos los clientes que venden o compran lo mismo.
model PriceLookup {
  id         String   @id @default(cuid())
  /// market | supplier
  kind       String
  /// Clave normalizada (producto + detalles relevantes)
  queryKey   String
  query      String
  results    Json
  searchedAt DateTime @default(now())

  @@unique([kind, queryKey])
}
